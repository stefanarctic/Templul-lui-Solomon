--- !u!114 &1905280851
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1905280849}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "De\u0219i deasupra sarcofagului se afla o inscrip\u021Bie \u201EMoartea
    \xEEi va ajunge pe cei care tulbur\u0103 somnul faraonului\u201D, la \xEEnceput
    nimeni nu i-a dat aten\u021Bie. Cu toate acestea, av\xE2nd \xEEn vedere c\u0103,
    la \u0219ase s\u0103pt\u0103m\xE2ni de la deschiderea morm\xE2ntului, 12 persoane
    din expedi\u021Bie au murit subit, pove\u0219tile despre blestemul lui Tutankamon
    au \xEEnceput s\u0103 se r\u0103sp\xE2ndeasc\u0103. La dou\u0103 luni dup\u0103
    deschiderea morm\xE2ntului lui Tutankamon a murit \u0219i Lordul Carnarvon. In
    acel moment toate luminile din ora\u0219 s-au stins . P\xE2n\u0103 \xEEn 1930,
    7 ani mai t\xE2rziu, 22 de persoane care au asistat la deschiderea morm\xE2ntului
    au murit, r\u0103sp\xE2ndind \u0219i mai mult povestea blestemului, \xEEns\u0103
    exper\u021Bii au spus c\u0103 cele dou\u0103 informa\u021Bii nu au leg\u0103tur\u0103
    \xEEntre ele, deoarece Carter, descoperitorul morm\xE2ntului, a murit din cauze
    naturale \xEEn 1939."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4bb705b0870dcf64295db1cf7c2208fe, type: 2}
