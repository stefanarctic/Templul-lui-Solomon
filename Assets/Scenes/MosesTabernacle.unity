  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Templul lui Solomon</b>\n\nConstruc\u021Bia \u0219i importan\u021Ba
    istoric\u0103\nTemplul lui Solomon, cunoscut \u0219i sub numele de Primul Templu
    din Ierusalim, a fost construit \xEEn jurul anului 957 \xEE.Hr. de c\u0103tre
    regele Solomon, fiul lui David. Acesta a fost ridicat pe Muntele Moria din Ierusalim
    \u0219i a servit drept loc de cult central pentru poporul evreu.\n\n<b>Arhitectura
    \u0219i structura</b>\n\nTemplul era o cl\u0103dire monumental\u0103, inspirat\u0103
    din stilurile arhitecturale ale Orientului Apropiat antic, \u0219i era \xEEmp\u0103r\u021Bit
    \xEEn trei p\u0103r\u021Bi principale:\n\nUlam \u2013 pridvorul sau vestibulul
    templului.\n\nHeichal \u2013 sala principal\u0103, unde se aflau altarul t\u0103m\xE2ierii,
    sfe\u0219nicul de aur \u0219i masa cu p\xE2inile punerii \xEEnainte.\n\nDebir
    (Sf\xE2nta Sfintelor) \u2013 cea mai sacr\u0103 \xEEnc\u0103pere, unde era p\u0103strat
    Chivotul Leg\u0103m\xE2ntului, simbolul prezen\u021Bei divine.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
