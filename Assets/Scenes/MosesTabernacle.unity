  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Howard Carter a fost un arheolog \u0219i egiptolog britanic care a tr\u0103it
    \xEEntre   9 mai 1874 \u0219i 2 martie 1939. \xCEn 1907 a \xEEnceput s\u0103
    lucreze pentru Lordul Carnarvon, care l-a angajat s\u0103 supravegheze excavarea
    mormintelor nobililor din Deir el-Bahri, l\xE2ng\u0103 Teba. \xCEn 1914, Lordul
    Carnarvon a primit concesiunea de a s\u0103pa \xEEn Valea Regilor. Carter a condus
    lucrarea, \xEEntreprinz\xE2nd o c\u0103utare sistematic\u0103 a oric\u0103ror
    morminte ratate de expedi\u021Biile anterioare.  La 4 noiembrie 1922, un t\xE2n\u0103r
    muncitor de pe \u0219antier s-a \xEEmpiedicat accidental de o piatr\u0103 care
    s-a dovedit a fi v\xE2rful unei trepte t\u0103iate \xEEn roca de baz\u0103. S-a
    dovedit c\u0103 acea scar\u0103 apar\u021Binea morm\xE2ntului lui Tutankamon
    care era singurul morm\xE2nt intact din Valea Regilor."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4bb705b0870dcf64295db1cf7c2208fe, type: 2}
