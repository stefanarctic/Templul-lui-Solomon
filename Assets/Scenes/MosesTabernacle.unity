  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Altarul Jertfelor era altarul principal folosit pentru sacrificiile prin
    ardere \u0219i alte jertfe aduse lui Dumnezeu. Construit din lemn de salc\xE2m
    \u0219i acoperit cu bronz, avea o form\u0103 p\u0103trat\u0103, m\u0103sur\xE2nd
    aproximativ 9 metri \xEEn lungime \u0219i l\u0103\u021Bime \u0219i 4,5 metri
    \xEEn \xEEn\u0103l\u021Bime. Era prev\u0103zut cu col\u021Buri numite coarnele
    altarului, unde se ungea s\xE2ngele jertfelor, \u0219i avea un gr\u0103tar de
    bronz pentru arderea animalelor sacrificate. Func\u021Biona ca loc central al
    cultului iudaic, unde preo\u021Bii aduceau jertfe pentru isp\u0103\u0219irea
    p\u0103catelor. A fost distrus sau luat de babilonieni \xEEn anul 586 \xEE.Hr.,
    odat\u0103 cu distrugerea Ierusalimului."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
